-- MIKO — the user's own 1..5 star rating per manga.
--
-- Independent of any remote/source score: at most one row per manga, and "no rating" is the
-- absence of the row (never a 0), so `manga_ratings` doubles as the "rated" filter index.
CREATE TABLE manga_ratings(
    manga_id INTEGER NOT NULL PRIMARY KEY,
    rating INTEGER NOT NULL,
    updated_at INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY(manga_id) REFERENCES mangas (_id)
    ON DELETE CASCADE
);

CREATE INDEX idx_manga_ratings_rating ON manga_ratings(rating);

getAll:
SELECT manga_id, rating
FROM manga_ratings;

get:
SELECT rating
FROM manga_ratings
WHERE manga_id = :mangaId;

upsert:
INSERT OR REPLACE INTO manga_ratings(manga_id, rating, updated_at)
VALUES (:mangaId, :rating, :updatedAt);

delete:
DELETE FROM manga_ratings
WHERE manga_id = :mangaId;
