-- MIKO — user-defined ("local") tags attached to a manga.
--
-- Local tags live next to the remote genres a source reports (`mangas.genre`); the UI shows both
-- sets unified but only local tags are editable. Tag names are compared case-insensitively, so the
-- unique index and every lookup carry an explicit `COLLATE NOCASE`.
CREATE TABLE manga_tags(
    _id INTEGER NOT NULL PRIMARY KEY,
    manga_id INTEGER NOT NULL,
    name TEXT NOT NULL,
    namespace TEXT,
    created_at INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY(manga_id) REFERENCES mangas (_id)
    ON DELETE CASCADE
);

CREATE UNIQUE INDEX idx_manga_tags_manga_name ON manga_tags(manga_id, name COLLATE NOCASE);
CREATE INDEX idx_manga_tags_name ON manga_tags(name COLLATE NOCASE);

getAll:
SELECT _id, manga_id, name, namespace, created_at
FROM manga_tags
ORDER BY name COLLATE NOCASE;

getByMangaId:
SELECT _id, manga_id, name, namespace, created_at
FROM manga_tags
WHERE manga_id = :mangaId
ORDER BY name COLLATE NOCASE;

getAllNames:
SELECT name
FROM manga_tags
GROUP BY name COLLATE NOCASE
ORDER BY COUNT(*) DESC, name COLLATE NOCASE;

insert:
INSERT INTO manga_tags(manga_id, name, namespace, created_at)
VALUES (:mangaId, :name, :namespace, :createdAt);

delete:
DELETE FROM manga_tags
WHERE _id = :id;

deleteByName:
DELETE FROM manga_tags
WHERE manga_id = :mangaId AND name COLLATE NOCASE = :name;

deleteByMangaId:
DELETE FROM manga_tags
WHERE manga_id = :mangaId;

-- `OR REPLACE` so renaming a tag onto one the same manga already has collapses the two rows
-- instead of aborting on idx_manga_tags_manga_name.
rename:
UPDATE OR REPLACE manga_tags
SET name = :newName
WHERE name COLLATE NOCASE = :oldName;

selectLastInsertedRowId:
SELECT last_insert_rowid();
